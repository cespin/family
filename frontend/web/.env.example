# Copy to .env for local overrides. Never put secrets here: every VITE_ value ships to the browser.
#
# VITE_COGNITO_DOMAIN and VITE_COGNITO_CLIENT_ID are injected by the deploy script from the
# deployed stacks, so they are not set in any committed file.

# Skips real sign-in during `npm run dev`. Only the exact value 1 turns it on.
VITE_MOCK_SESSION=1
